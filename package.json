    "cz": "git cz",
    "license:mit": "npx license MIT",
    "release": "npx bumpp"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "vite-svg-loader": "^5.1.1",
    "vue": "3.6.0-beta.5",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.3.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@huberyyang/todo-scripts": "^1.1.1",
    "@iconify-json/carbon": "^1.2.25",
    "@unocss/eslint-plugin": "^66.8.0",
    "@unocss/preset-wind3": "^66.8.0",
    "@unocss/reset": "^66.8.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "commitizen": "^4.3.2",
    "cz-git": "^1.13.2",
    "eslint": "^10.8.1",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^6.0.3",
    "unocss": "^66.8.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.2.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.10"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*": "eslint --fix"
