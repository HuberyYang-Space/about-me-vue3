{
  "name": "about-me-vue3",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "description": "about-me 个人主页 vue3版本",
  "author": "Hubery Yang",
  "license": "MIT",
  "homepage": "https://github.com/Hub-yang/about-me-vue3#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hub-yang/about-me-vue3.git"
  },
  "bugs": {
    "url": "https://github.com/Hub-yang/about-me-vue3/issues"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
